# ===== Database =====
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/bachmai_hrm?schema=public"

# ===== Redis (Memurai on Windows / Redis on Linux) =====
REDIS_URL="redis://127.0.0.1:6379"

# ===== API =====
API_PORT=4000
# Secret ký JWT — tối thiểu 32 ký tự ngẫu nhiên
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
JWT_ACCESS_TTL_MINUTES=15
# Phiên đăng nhập: thời hạn tuyệt đối và thời gian không hoạt động
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Khóa tài khoản sau N lần đăng nhập sai, trong M phút
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
# true khi chạy HTTPS (production)
COOKIE_SECURE=false
# Khóa mã hóa dữ liệu nhạy cảm (CCCD, MST, STK, secret 2FA): 32 byte dạng base64.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ĐỔI KHÓA = MẤT DỮ LIỆU ĐÃ MÃ HÓA. Sao lưu khóa an toàn, tách khỏi bản sao lưu DB.
DATA_ENCRYPTION_KEY="CHANGE_ME"

# ===== Lưu trữ file =====
# Thư mục lưu file tải lên (tuyệt đối hoặc tương đối so với thư mục gốc repo)
STORAGE_DIR="storage"
UPLOAD_MAX_MB=20

# ===== Kết nối phần mềm Fast (bỏ trống khi chưa có) =====
FAST_API_URL=""
FAST_API_KEY=""

# ===== Web =====
WEB_PORT=3000
# URL nội bộ để Next.js proxy /api/* sang API
API_INTERNAL_URL="http://127.0.0.1:4000"

# ===== Seed =====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD="CHANGE_ME"

# ===== Tiến trình =====
# all = API + xử lý nền (mặc định) | api = chỉ phục vụ HTTP | worker = chỉ xử lý nền (đồng bộ máy chấm công, tính công)
APP_ROLE=all
