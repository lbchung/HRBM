enum ShiftType {
  WORK
  DUTY
}

/// Ca làm việc / ca trực. Giờ theo giờ Việt Nam "HH:mm"; endTime ≤ startTime = ca qua đêm.
model Shift {
  id                   String    @id @default(uuid()) @db.Uuid
  code                 String    @unique @db.VarChar(20)
  name                 String    @db.VarChar(200)
  type                 ShiftType
  startTime            String    @map("start_time") @db.VarChar(5)
  endTime              String    @map("end_time") @db.VarChar(5)
  breakMinutes         Int       @default(0) @map("break_minutes")
  lateGraceMinutes     Int       @default(5) @map("late_grace_minutes")
  earlyGraceMinutes    Int       @default(5) @map("early_grace_minutes")
  checkInBeforeMinutes Int       @default(120) @map("check_in_before_minutes")
  checkOutAfterMinutes Int       @default(240) @map("check_out_after_minutes")
  /// Số công quy đổi
  workUnits            Decimal   @default(1) @map("work_units") @db.Decimal(4, 2)
  color                String?   @db.VarChar(20)
  /// null = dùng cho cả hai cơ sở
  campusId             String?   @map("campus_id") @db.Uuid
  sortOrder            Int       @default(0) @map("sort_order")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy            String?   @map("created_by") @db.Uuid
  updatedBy            String?   @map("updated_by") @db.Uuid

  schedules     Schedule[]
  dutyRates     DutyPayRate[]
  defaultUnits  Unit[]           @relation("UnitDefaultShift")
  timesheetRows DailyTimesheet[]

  @@map("shifts")
}

/// Mức tiền trực theo ca trực, có ngày hiệu lực
model DutyPayRate {
  id            String   @id @default(uuid()) @db.Uuid
  shiftId       String   @map("shift_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  amount        Decimal  @db.Decimal(18, 2)
  legalBasis    String?  @map("legal_basis") @db.VarChar(500)
  note          String?  @db.VarChar(1000)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, effectiveFrom])
  @@map("duty_pay_rates")
}

model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@map("holidays")
}

/// Máy chấm công Face ID (Hikvision ISAPI). Watermark: last_event_time + last_serial_no.
model AttendanceDevice {
  id                 String    @id @default(uuid()) @db.Uuid
  code               String    @unique @db.VarChar(20)
  name               String    @db.VarChar(200)
  campusId           String    @map("campus_id") @db.Uuid
  location           String?   @db.VarChar(300)
  host               String    @db.VarChar(200)
  port               Int       @default(80)
  useHttps           Boolean   @default(false) @map("use_https")
  username           String    @db.VarChar(100)
  /// Mật khẩu máy đã mã hóa (AES-256-GCM)
  passwordEnc        String    @map("password_enc") @db.VarChar(500)
  eventMinors        String    @default("75") @map("event_minors") @db.VarChar(100)
  model              String?   @db.VarChar(100)
  serialNumber       String?   @map("serial_number") @db.VarChar(100)
  firmware           String?   @db.VarChar(100)
  isActive           Boolean   @default(true) @map("is_active")
  lastEventTime      DateTime? @map("last_event_time") @db.Timestamptz(6)
  lastSerialNo       Int?      @map("last_serial_no")
  lastSyncAt         DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastSuccessAt      DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastSyncStatus     String?   @map("last_sync_status") @db.VarChar(20)
  lastError          String?   @map("last_error") @db.VarChar(1000)
  lastFetchedCount   Int?      @map("last_fetched_count")
  /// Giờ máy − giờ máy chủ (giây)
  clockOffsetSeconds Int?      @map("clock_offset_seconds")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  campus  Campus            @relation(fields: [campusId], references: [id])
  punches AttendancePunch[]

  @@map("attendance_devices")
}

/// Dữ liệu quét gốc — BẤT BIẾN. Chống trùng bằng (device_id, serial_no).
model AttendancePunch {
  id         BigInt   @id @default(autoincrement())
  deviceId   String   @map("device_id") @db.Uuid
  serialNo   Int      @map("serial_no")
  employeeNo String   @map("employee_no") @db.VarChar(50)
  employeeId String?  @map("employee_id") @db.Uuid
  punchTime  DateTime @map("punch_time") @db.Timestamptz(6)
  campusId   String   @map("campus_id") @db.Uuid
  verifyMode String?  @map("verify_mode") @db.VarChar(30)
  eventMinor Int?     @map("event_minor")
  personName String?  @map("person_name") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  device   AttendanceDevice @relation(fields: [deviceId], references: [id])
  employee Employee?        @relation(fields: [employeeId], references: [id])

  @@unique([deviceId, serialNo])
  @@index([employeeId, punchTime])
  @@index([punchTime], type: Brin)
  @@index([employeeNo])
  @@map("attendance_raw_punches")
}

/// Lịch làm việc / lịch trực: một nhân viên có thể có nhiều ca trong một ngày
model Schedule {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date
  shiftId    String   @map("shift_id") @db.Uuid
  note       String?  @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date, shiftId])
  @@index([date])
  @@map("schedules")
}

// ===================== NGHỈ - CÔNG TÁC =====================

model LeaveType {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique @db.VarChar(20)
  name               String   @db.VarChar(200)
  /// Ký hiệu trên bảng công
  symbol             String   @db.VarChar(10)
  paid               Boolean  @default(true)
  /// Ngày nghỉ vẫn được tính công (công tác, học tập…)
  countsAsWork       Boolean  @default(false) @map("counts_as_work")
  /// Trừ vào quỹ phép năm
  deductAnnualLeave  Boolean  @default(false) @map("deduct_annual_leave")
  requiresAttachment Boolean  @default(false) @map("requires_attachment")
  workflowCode       String   @default("LEAVE_DEFAULT") @map("workflow_code") @db.VarChar(50)
  maxDaysPerRequest  Int?     @map("max_days_per_request")
  sortOrder          Int      @default(0) @map("sort_order")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid

  requests LeaveRequest[]

  @@map("leave_types")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDay {
  AM
  PM
}

model LeaveRequest {
  id                String      @id @default(uuid()) @db.Uuid
  /// Số phiếu: NP-2026-000001
  code              String      @unique @db.VarChar(30)
  employeeId        String      @map("employee_id") @db.Uuid
  leaveTypeId       String      @map("leave_type_id") @db.Uuid
  fromDate          DateTime    @map("from_date") @db.Date
  toDate            DateTime    @map("to_date") @db.Date
  startSession      HalfDay     @default(AM) @map("start_session")
  endSession        HalfDay     @default(PM) @map("end_session")
  days              Decimal     @db.Decimal(5, 1)
  reason            String      @db.VarChar(1000)
  destination       String?     @db.VarChar(300)
  fileId            String?     @map("file_id") @db.Uuid
  status            LeaveStatus @default(PENDING)
  approvalRequestId String?     @unique @map("approval_request_id") @db.Uuid
  unitId            String      @map("unit_id") @db.Uuid
  campusId          String      @map("campus_id") @db.Uuid
  createdBy         String      @map("created_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt         DateTime?   @map("decided_at") @db.Timestamptz(6)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, fromDate])
  @@index([status])
  @@index([unitId, fromDate])
  @@map("leave_requests")
}

/// Quỹ phép năm
model LeaveBalance {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  year            Int
  entitledDays    Decimal  @map("entitled_days") @db.Decimal(5, 1)
  carriedOverDays Decimal  @default(0) @map("carried_over_days") @db.Decimal(5, 1)
  adjustmentDays  Decimal  @default(0) @map("adjustment_days") @db.Decimal(5, 1)
  note            String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("leave_balances")
}

// ===================== BẢNG CÔNG =====================

enum TimesheetStatus {
  PRESENT
  ABSENT
  LEAVE
  LEAVE_HALF
  HOLIDAY
  MISSING_IN
  MISSING_OUT
  NO_SCHEDULE
}

/// Công ngày — tính lại được từ dữ liệu quét + lịch ca + phiếu nghỉ. Điều chỉnh thủ công lưu riêng (override_*).
model DailyTimesheet {
  id                String          @id @default(uuid()) @db.Uuid
  employeeId        String          @map("employee_id") @db.Uuid
  date              DateTime        @db.Date
  /// id ca, hoặc "NONE" khi không xếp ca
  slotKey           String          @map("slot_key") @db.VarChar(40)
  shiftId           String?         @map("shift_id") @db.Uuid
  unitId            String          @map("unit_id") @db.Uuid
  /// Cơ sở thực tế (theo máy quét)
  campusId          String?         @map("campus_id") @db.Uuid
  /// Cơ sở phải làm (phân công / cơ sở gốc)
  expectedCampusId  String          @map("expected_campus_id") @db.Uuid
  status            TimesheetStatus
  symbol            String          @db.VarChar(10)
  workUnits         Decimal         @map("work_units") @db.Decimal(4, 2)
  scheduledStart    DateTime?       @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd      DateTime?       @map("scheduled_end") @db.Timestamptz(6)
  firstIn           DateTime?       @map("first_in") @db.Timestamptz(6)
  lastOut           DateTime?       @map("last_out") @db.Timestamptz(6)
  workedMinutes     Int             @default(0) @map("worked_minutes")
  lateMinutes       Int             @default(0) @map("late_minutes")
  earlyMinutes      Int             @default(0) @map("early_minutes")
  isLate            Boolean         @default(false) @map("is_late")
  isEarly           Boolean         @default(false) @map("is_early")
  campusMismatch    Boolean         @default(false) @map("campus_mismatch")
  leaveRequestId    String?         @map("leave_request_id") @db.Uuid
  overrideSymbol    String?         @map("override_symbol") @db.VarChar(10)
  overrideWorkUnits Decimal?        @map("override_work_units") @db.Decimal(4, 2)
  overrideReason    String?         @map("override_reason") @db.VarChar(500)
  overriddenBy      String?         @map("overridden_by") @db.Uuid
  overriddenAt      DateTime?       @map("overridden_at") @db.Timestamptz(6)
  computedAt        DateTime        @default(now()) @map("computed_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date, slotKey])
  @@index([unitId, date])
  @@index([date])
  @@map("daily_timesheets")
}

enum PeriodStatus {
  OPEN
  CONFIRMED
  CLOSED
}

/// Kỳ công tháng của đơn vị: đơn vị xác nhận → TCCB chốt (khóa)
model TimesheetPeriod {
  id          String       @id @default(uuid()) @db.Uuid
  unitId      String       @map("unit_id") @db.Uuid
  month       String       @db.VarChar(7)
  status      PeriodStatus @default(OPEN)
  confirmedBy String?      @map("confirmed_by") @db.Uuid
  confirmedAt DateTime?    @map("confirmed_at") @db.Timestamptz(6)
  closedBy    String?      @map("closed_by") @db.Uuid
  closedAt    DateTime?    @map("closed_at") @db.Timestamptz(6)
  note        String?      @db.VarChar(500)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, month])
  @@map("timesheet_periods")
}

/// Ảnh chụp công tháng tại thời điểm chốt — đầu vào cho tính lương
model MonthlyTimesheet {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  month      String   @db.VarChar(7)
  unitId     String   @map("unit_id") @db.Uuid
  workUnits  Decimal  @map("work_units") @db.Decimal(6, 2)
  dutyCount  Int      @default(0) @map("duty_count")
  totals     Json
  closedAt   DateTime @default(now()) @map("closed_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@index([month, unitId])
  @@map("monthly_timesheets")
}

// ===================== THÔNG BÁO =====================

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(300)
  body      String?   @db.VarChar(1000)
  link      String?   @db.VarChar(300)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ===================== TIỀN LƯƠNG =====================

enum ComponentKind {
  EARNING
  DEDUCTION
  EMPLOYER
  INFO
}

/// Khoản lương — công thức là dữ liệu cấu hình (bộ tính an toàn packages/shared/src/payroll/formula.ts)
model SalaryComponent {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique @db.VarChar(40)
  name          String        @db.VarChar(200)
  kind          ComponentKind
  formula       String        @db.VarChar(2000)
  taxable       Boolean       @default(false)
  roundDigits   Int           @default(0) @map("round_digits")
  sortOrder     Int           @default(0) @map("sort_order")
  showOnPayslip Boolean       @default(true) @map("show_on_payslip")
  description   String?       @db.VarChar(1000)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?       @map("created_by") @db.Uuid
  updatedBy     String?       @map("updated_by") @db.Uuid

  @@map("salary_components")
}

/// Thang lương (A1, A2.1, B…) — thời gian giữ bậc để nâng lương thường xuyên
model SalaryScale {
  id                  String            @id @default(uuid()) @db.Uuid
  code                String            @unique @db.VarChar(20)
  name                String            @db.VarChar(200)
  raiseIntervalMonths Int               @map("raise_interval_months")
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  steps SalaryScaleStep[]

  @@map("salary_scales")
}

model SalaryScaleStep {
  id          String  @id @default(uuid()) @db.Uuid
  scaleId     String  @map("scale_id") @db.Uuid
  step        Int
  coefficient Decimal @db.Decimal(6, 3)

  scale SalaryScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, step])
  @@map("salary_scale_steps")
}

/// Biểu thuế TNCN lũy tiến từng phần (tháng) theo ngày hiệu lực
model PitBracketVersion {
  id            String   @id @default(uuid()) @db.Uuid
  effectiveFrom DateTime @unique @map("effective_from") @db.Date
  /// [{ "upTo": "5000000" | null, "rate": "5" }, …]
  brackets      Json
  legalBasis    String?  @map("legal_basis") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid

  @@map("pit_bracket_versions")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATING
  CALCULATED
  CLOSED
}

/// Kỳ lương. Đã chốt → khóa; điều chỉnh sau đó đi qua truy lĩnh ở kỳ sau.
model PayrollRun {
  id            String           @id @default(uuid()) @db.Uuid
  code          String           @unique @db.VarChar(30)
  month         String           @db.VarChar(7)
  name          String           @db.VarChar(200)
  status        PayrollRunStatus @default(DRAFT)
  note          String?          @db.VarChar(1000)
  employeeCount Int              @default(0) @map("employee_count")
  progress      Int              @default(0)
  errorCount    Int              @default(0) @map("error_count")
  totals        Json?
  calculatedAt  DateTime?        @map("calculated_at") @db.Timestamptz(6)
  closedAt      DateTime?        @map("closed_at") @db.Timestamptz(6)
  closedBy      String?          @map("closed_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy     String?          @map("created_by") @db.Uuid

  items PayrollItem[]

  @@index([month])
  @@map("payroll_runs")
}

/// Phiếu lương một nhân viên trong kỳ — lưu đủ biến đầu vào để giải trình
model PayrollItem {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  unitId          String   @map("unit_id") @db.Uuid
  campusId        String   @map("campus_id") @db.Uuid
  salaryForm      String?  @map("salary_form") @db.VarChar(20)
  inputs          Json
  /// Số công theo cơ sở thực tế { campusId: "units" } — phân bổ chi phí lương theo cơ sở
  campusSplit     Json?    @map("campus_split")
  gross           Decimal  @db.Decimal(18, 2)
  taxable         Decimal  @db.Decimal(18, 2)
  deductions      Decimal  @db.Decimal(18, 2)
  employerCost    Decimal  @map("employer_cost") @db.Decimal(18, 2)
  net             Decimal  @db.Decimal(18, 2)
  errors          Json?
  timesheetClosed Boolean  @default(false) @map("timesheet_closed")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run      PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayrollLine[]

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([runId, unitId])
  @@map("payroll_items")
}

model PayrollLine {
  id        BigInt        @id @default(autoincrement())
  itemId    String        @map("item_id") @db.Uuid
  code      String        @db.VarChar(40)
  name      String        @db.VarChar(200)
  kind      ComponentKind
  taxable   Boolean       @default(false)
  amount    Decimal       @db.Decimal(24, 10)
  sortOrder Int           @default(0) @map("sort_order")

  item PayrollItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("payroll_lines")
}

enum RaiseKind {
  REGULAR
  EARLY
  BEYOND_SCALE
}

enum RaiseStatus {
  PROPOSED
  APPROVED
  REJECTED
}

/// Đề xuất / quyết định nâng lương
model SalaryRaise {
  id              String      @id @default(uuid()) @db.Uuid
  employeeId      String      @map("employee_id") @db.Uuid
  kind            RaiseKind
  scaleCode       String?     @map("scale_code") @db.VarChar(20)
  fromStep        Int?        @map("from_step")
  toStep          Int?        @map("to_step")
  fromCoefficient Decimal?    @map("from_coefficient") @db.Decimal(6, 3)
  toCoefficient   Decimal?    @map("to_coefficient") @db.Decimal(6, 3)
  fromBeyondPct   Decimal?    @map("from_beyond_pct") @db.Decimal(5, 2)
  toBeyondPct     Decimal?    @map("to_beyond_pct") @db.Decimal(5, 2)
  dueDate         DateTime    @map("due_date") @db.Date
  effectiveDate   DateTime    @map("effective_date") @db.Date
  status          RaiseStatus @default(PROPOSED)
  reason          String?     @db.VarChar(1000)
  decisionNo      String?     @map("decision_no") @db.VarChar(100)
  decisionDate    DateTime?   @map("decision_date") @db.Date
  resultSalaryId  String?     @map("result_salary_id") @db.Uuid
  createdBy       String?     @map("created_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedBy       String?     @map("decided_by") @db.Uuid
  decidedAt       DateTime?   @map("decided_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status, dueDate])
  @@map("salary_raises")
}

enum RetroStatus {
  PENDING
  INCLUDED
  CANCELLED
}

/// Truy lĩnh: chênh lệch các kỳ lương đã chốt khi quyết định lương/phụ cấp có hiệu lực hồi tố
model RetroPay {
  id            String      @id @default(uuid()) @db.Uuid
  employeeId    String      @map("employee_id") @db.Uuid
  reason        String      @db.VarChar(500)
  fromMonth     String      @map("from_month") @db.VarChar(7)
  toMonth       String      @map("to_month") @db.VarChar(7)
  amount        Decimal     @db.Decimal(18, 2)
  insAmount     Decimal     @default(0) @map("ins_amount") @db.Decimal(18, 2)
  details       Json
  status        RetroStatus @default(PENDING)
  includedRunId String?     @map("included_run_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@map("retro_pays")
}

enum ExtraIncomeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

/// Đề xuất thanh toán thu nhập tăng thêm do khoa lập → TCKT duyệt → chi trong kỳ lương
model ExtraIncomeProposal {
  id                String            @id @default(uuid()) @db.Uuid
  code              String            @unique @db.VarChar(30)
  unitId            String            @map("unit_id") @db.Uuid
  month             String            @db.VarChar(7)
  title             String            @db.VarChar(300)
  note              String?           @db.VarChar(1000)
  status            ExtraIncomeStatus @default(PENDING)
  total             Decimal           @db.Decimal(18, 2)
  approvalRequestId String?           @unique @map("approval_request_id") @db.Uuid
  paidRunId         String?           @map("paid_run_id") @db.Uuid
  createdBy         String            @map("created_by") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines ExtraIncomeLine[]

  @@index([month, status])
  @@index([unitId])
  @@map("extra_income_proposals")
}

model ExtraIncomeLine {
  id         String  @id @default(uuid()) @db.Uuid
  proposalId String  @map("proposal_id") @db.Uuid
  employeeId String  @map("employee_id") @db.Uuid
  amount     Decimal @db.Decimal(18, 2)
  note       String? @db.VarChar(300)

  proposal ExtraIncomeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  employee Employee            @relation(fields: [employeeId], references: [id])

  @@unique([proposalId, employeeId])
  @@index([employeeId])
  @@map("extra_income_lines")
}
