// Quy ước: bảng snake_case số nhiều, id UUID, cột chuẩn created_at/updated_at/created_by/updated_by/deleted_at.
// Thời gian lưu timestamptz (UTC). Tiền dùng Decimal — không dùng Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== TỔ CHỨC =====================

/// Cơ sở bệnh viện (Hà Nội, Ninh Bình)
model Campus {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(200)
  address   String?   @db.VarChar(500)
  phone     String?   @db.VarChar(50)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  units       Unit[]
  users       User[]
  employees   Employee[]
  assignments CampusAssignment[]
  devices     AttendanceDevice[]

  @@map("campuses")
}

enum UnitType {
  KHOA
  PHONG
  TRUNG_TAM
  VIEN
  KHAC
}

/// Đơn vị: khoa, phòng, trung tâm, viện — dạng cây
model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(20)
  name      String    @db.VarChar(200)
  shortName String?   @map("short_name") @db.VarChar(50)
  type      UnitType
  parentId  String?   @map("parent_id") @db.Uuid
  /// Cơ sở chính của đơn vị (null = hoạt động ở cả hai cơ sở)
  campusId  String?   @map("campus_id") @db.Uuid
  /// Ca mặc định của đơn vị (gợi ý khi xếp lịch)
  defaultShiftId String? @map("default_shift_id") @db.Uuid
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  defaultShift Shift?                @relation("UnitDefaultShift", fields: [defaultShiftId], references: [id])
  parent       Unit?                 @relation("UnitTree", fields: [parentId], references: [id])
  children     Unit[]                @relation("UnitTree")
  campus       Campus?               @relation(fields: [campusId], references: [id])
  users        User[]
  managedBy    UserManagedUnit[]
  employees    Employee[]
  assignments  CampusAssignment[]
  historyFrom  EmployeeWorkHistory[] @relation("WorkHistoryFrom")
  historyTo    EmployeeWorkHistory[] @relation("WorkHistoryTo")
  timesheetPeriods TimesheetPeriod[]

  @@index([parentId])
  @@index([campusId])
  @@map("units")
}

// ===================== HỆ THỐNG / PHÂN QUYỀN =====================

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum DataScope {
  ALL
  CAMPUS
  UNIT
  SELF
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique @db.VarChar(50)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  fullName           String     @map("full_name") @db.VarChar(200)
  email              String?    @db.VarChar(200)
  phone              String?    @db.VarChar(20)
  /// Cơ sở gốc — dùng cho phạm vi dữ liệu CAMPUS
  campusId           String?    @map("campus_id") @db.Uuid
  /// Đơn vị của tài khoản — dùng cho phạm vi dữ liệu UNIT
  unitId             String?    @map("unit_id") @db.Uuid
  status             UserStatus @default(ACTIVE)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Secret TOTP đã mã hóa (AES-256-GCM)
  totpSecret         String?    @map("totp_secret") @db.VarChar(255)
  totpEnabled        Boolean    @default(false) @map("totp_enabled")
  /// Bước thời gian TOTP đã dùng gần nhất — chống dùng lại mã
  totpLastCounter    Int?       @map("totp_last_counter")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?    @map("created_by") @db.Uuid
  updatedBy          String?    @map("updated_by") @db.Uuid
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  campus       Campus?           @relation(fields: [campusId], references: [id])
  unit         Unit?             @relation(fields: [unitId], references: [id])
  roles        UserRole[]
  permissions  UserPermission[]
  managedUnits UserManagedUnit[]
  sessions     Session[]
  employee     Employee?
  approvalAssignments ApprovalAssignee[]
  notifications       Notification[]

  @@index([campusId])
  @@index([unitId])
  @@map("users")
}

/// Nhóm tài khoản
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(200)
  description String?   @db.VarChar(500)
  dataScope   DataScope @default(SELF) @map("data_scope")
  /// Nhóm hệ thống: không xóa được
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Danh mục quyền — đồng bộ từ packages/shared/src/constants/permissions.ts
model Permission {
  code   String @id @db.VarChar(100)
  module String @db.VarChar(50)
  name   String @db.VarChar(200)

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code") @db.VarChar(100)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Quyền bổ sung riêng cho từng tài khoản (ngoài quyền của nhóm)
model UserPermission {
  userId         String @map("user_id") @db.Uuid
  permissionCode String @map("permission_code") @db.VarChar(100)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("user_permissions")
}

/// Đơn vị tài khoản được quản lý (trưởng khoa phụ trách nhiều đơn vị)
model UserManagedUnit {
  userId String @map("user_id") @db.Uuid
  unitId String @map("unit_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@map("user_managed_units")
}

/// Phiên đăng nhập; refresh token chỉ lưu hash SHA-256
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip               String?   @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Nhật ký thay đổi dữ liệu và sự kiện bảo mật
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  username  String?  @db.VarChar(100)
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===================== DÙNG CHUNG =====================

/// File đã tải lên. owner_type/owner_id xác định ai được tải về (kiểm tra qua FileAccessRegistry).
model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  /// Đường dẫn tương đối trong STORAGE_DIR
  storageKey   String   @unique @map("storage_key") @db.VarChar(300)
  sha256       String   @db.VarChar(64)
  ownerType    String?  @map("owner_type") @db.VarChar(50)
  ownerId      String?  @map("owner_id") @db.VarChar(100)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ownerType, ownerId])
  @@map("files")
}

/// Danh mục dùng chung — loại danh mục khai báo tại packages/shared/src/constants/catalogs.ts
model CatalogItem {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(300)
  description String?  @db.VarChar(500)
  meta        Json?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  @@unique([type, code])
  @@index([type, sortOrder])
  @@map("catalog_items")
}

/// Tham số chính sách theo ngày hiệu lực. Hết hiệu lực = ngày trước phiên bản kế tiếp.
model PolicyParameter {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @db.VarChar(50)
  effectiveFrom DateTime @map("effective_from") @db.Date
  value         Decimal  @db.Decimal(18, 4)
  /// Căn cứ văn bản pháp lý
  legalBasis    String?  @map("legal_basis") @db.VarChar(500)
  note          String?  @db.VarChar(1000)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid

  @@unique([code, effectiveFrom])
  @@map("policy_parameters")
}

// ===================== QUY TRÌNH DUYỆT =====================

enum ApproverType {
  SELECTED
  UNIT_MANAGER
  ROLE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalWorkflow {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(200)
  targetType  String   @map("target_type") @db.VarChar(50)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  @@map("approval_workflows")
}

model ApprovalStep {
  id           String       @id @default(uuid()) @db.Uuid
  workflowId   String       @map("workflow_id") @db.Uuid
  stepOrder    Int          @map("step_order")
  name         String       @db.VarChar(200)
  approverType ApproverType @map("approver_type")
  roleId       String?      @map("role_id") @db.Uuid

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepOrder])
  @@map("approval_steps")
}

model ApprovalRequest {
  id            String         @id @default(uuid()) @db.Uuid
  workflowId    String         @map("workflow_id") @db.Uuid
  targetType    String         @map("target_type") @db.VarChar(50)
  targetId      String         @map("target_id") @db.VarChar(100)
  title         String         @db.VarChar(300)
  content       String?
  status        ApprovalStatus @default(PENDING)
  currentStep   Int            @map("current_step")
  /// Ảnh chụp các bước tại thời điểm gửi — sửa quy trình không ảnh hưởng phiếu đang chạy
  stepsSnapshot Json           @map("steps_snapshot")
  unitId        String?        @map("unit_id") @db.Uuid
  campusId      String?        @map("campus_id") @db.Uuid
  requestedBy   String         @map("requested_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt   DateTime?      @map("completed_at") @db.Timestamptz(6)

  workflow  ApprovalWorkflow   @relation(fields: [workflowId], references: [id])
  assignees ApprovalAssignee[]
  actions   ApprovalAction[]

  @@index([targetType, targetId])
  @@index([status])
  @@index([requestedBy])
  @@map("approval_requests")
}

/// Người duyệt của từng bước (xác định khi bước được kích hoạt, hoặc khi gửi với bước SELECTED)
model ApprovalAssignee {
  requestId String @map("request_id") @db.Uuid
  stepOrder Int    @map("step_order")
  userId    String @map("user_id") @db.Uuid

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestId, stepOrder, userId])
  @@index([userId])
  @@map("approval_assignees")
}

model ApprovalAction {
  id        BigInt   @id @default(autoincrement())
  requestId String   @map("request_id") @db.Uuid
  stepOrder Int      @map("step_order")
  actorId   String   @map("actor_id") @db.Uuid
  actorName String   @map("actor_name") @db.VarChar(200)
  /// SUBMIT | APPROVE | REJECT | CANCEL
  action    String   @db.VarChar(20)
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([actorId])
  @@map("approval_actions")
}

// ===================== NHÂN SỰ =====================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  WORKING
  PROBATION
  LONG_LEAVE
  RESIGNED
  RETIRED
}

enum SalaryForm {
  COEFFICIENT
  FIXED
}

enum RecordSource {
  LOCAL
  FAST
}

/// Hồ sơ nhân viên. Trường *_enc mã hóa AES-256-GCM; id_number_hash là blind index để tra cứu/chống trùng.
/// Các trường *_code tham chiếu catalog_items theo mã.
model Employee {
  id                 String         @id @default(uuid()) @db.Uuid
  code               String         @unique @db.VarChar(30)
  fullName           String         @map("full_name") @db.VarChar(200)
  /// Chuỗi không dấu để tìm kiếm: mã + họ tên + điện thoại + email
  searchText         String         @default("") @map("search_text") @db.VarChar(600)
  gender             Gender
  dateOfBirth        DateTime?      @map("date_of_birth") @db.Date
  placeOfBirth       String?        @map("place_of_birth") @db.VarChar(300)
  hometown           String?        @db.VarChar(300)
  nationality        String?        @db.VarChar(100)
  ethnicityCode      String?        @map("ethnicity_code") @db.VarChar(50)
  religionCode       String?        @map("religion_code") @db.VarChar(50)
  idNumberEnc        String?        @map("id_number_enc") @db.VarChar(255)
  idNumberHash       String?        @unique @map("id_number_hash") @db.VarChar(64)
  idIssueDate        DateTime?      @map("id_issue_date") @db.Date
  idIssuePlace       String?        @map("id_issue_place") @db.VarChar(200)
  taxCodeEnc         String?        @map("tax_code_enc") @db.VarChar(255)
  socialInsuranceNo  String?        @map("social_insurance_no") @db.VarChar(20)
  healthInsuranceNo  String?        @map("health_insurance_no") @db.VarChar(20)
  bankAccountEnc     String?        @map("bank_account_enc") @db.VarChar(255)
  bankCode           String?        @map("bank_code") @db.VarChar(50)
  bankBranch         String?        @map("bank_branch") @db.VarChar(200)
  phone              String?        @db.VarChar(20)
  email              String?        @db.VarChar(200)
  permanentAddress   String?        @map("permanent_address") @db.VarChar(500)
  currentAddress     String?        @map("current_address") @db.VarChar(500)
  maritalStatus      String?        @map("marital_status") @db.VarChar(20)
  photoFileId        String?        @map("photo_file_id") @db.Uuid
  /// Cơ sở gốc
  campusId           String         @map("campus_id") @db.Uuid
  unitId             String         @map("unit_id") @db.Uuid
  positionCode       String?        @map("position_code") @db.VarChar(50)
  jobTitleCode       String?        @map("job_title_code") @db.VarChar(50)
  contractTypeCode   String?        @map("contract_type_code") @db.VarChar(50)
  educationLevelCode String?        @map("education_level_code") @db.VarChar(50)
  academicTitleCode  String?        @map("academic_title_code") @db.VarChar(50)
  specialty          String?        @db.VarChar(200)
  /// Mã chấm công (employeeNo trên máy Face ID)
  attendanceCode     String?        @unique @map("attendance_code") @db.VarChar(50)
  /// Ngày vào làm việc tại bệnh viện
  startDate          DateTime?      @map("start_date") @db.Date
  recruitmentDate    DateTime?      @map("recruitment_date") @db.Date
  partyJoinDate      DateTime?      @map("party_join_date") @db.Date
  status             EmployeeStatus @default(WORKING)
  leaveDate          DateTime?      @map("leave_date") @db.Date
  leaveReason        String?        @map("leave_reason") @db.VarChar(500)
  /// Tài khoản đăng nhập của nhân viên (phạm vi SELF)
  userId             String?        @unique @map("user_id") @db.Uuid
  source             RecordSource   @default(LOCAL)
  externalId         String?        @map("external_id") @db.VarChar(100)
  note               String?        @db.VarChar(2000)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?        @map("created_by") @db.Uuid
  updatedBy          String?        @map("updated_by") @db.Uuid
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(6)

  campus             Campus                      @relation(fields: [campusId], references: [id])
  unit               Unit                        @relation(fields: [unitId], references: [id])
  user               User?                       @relation(fields: [userId], references: [id])
  family             EmployeeFamilyMember[]
  workHistory        EmployeeWorkHistory[]
  contracts          EmployeeContract[]
  assignments        CampusAssignment[]
  documents          EmployeeDocument[]
  trainings          EmployeeTraining[]
  rewards            EmployeeReward[]
  disciplines        EmployeeDiscipline[]
  salaries           EmployeeSalary[]
  allowances         EmployeeAllowance[]
  incomeCoefficients EmployeeIncomeCoefficient[]
  punches            AttendancePunch[]
  schedules          Schedule[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  dailyTimesheets    DailyTimesheet[]
  monthlyTimesheets  MonthlyTimesheet[]
  payrollItems       PayrollItem[]
  salaryRaises       SalaryRaise[]
  retroPays          RetroPay[]
  extraIncomeLines   ExtraIncomeLine[]

  @@unique([source, externalId])
  @@index([campusId])
  @@index([unitId])
  @@index([status])
  @@index([searchText])
  @@map("employees")
}

model EmployeeFamilyMember {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  relationshipCode String    @map("relationship_code") @db.VarChar(50)
  fullName         String    @map("full_name") @db.VarChar(200)
  birthYear        Int?      @map("birth_year")
  occupation       String?   @db.VarChar(200)
  workplace        String?   @db.VarChar(300)
  phone            String?   @db.VarChar(20)
  /// Người phụ thuộc giảm trừ thuế TNCN
  isDependant      Boolean   @default(false) @map("is_dependant")
  dependantTaxCode String?   @map("dependant_tax_code") @db.VarChar(20)
  deductionFrom    DateTime? @map("deduction_from") @db.Date
  deductionTo      DateTime? @map("deduction_to") @db.Date
  note             String?   @db.VarChar(1000)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid

