{
  "name": "@bachmai/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0"
  },
  "devDependencies": {
    "@bachmai/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@types/node": "^22.18.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.17.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
